    "turns": [
      {
        "idx": 3,
        "topic": "concept_meaning",
        "module": "concept",
        "text": "Democracy means people choose and can remove their government in free elections. But it also means courts are independent and the press can criticise those in power, because otherwise elections become a show.",
        "codes": [
          "elections",
          "freedoms",
          "checks",
          "politicians"
        ],
        "justified": true
      },
      {
        "idx": 5,
        "topic": "concept_boundary",
        "module": "concept",
        "text": "No, that is not a democracy. If newspapers cannot criticise the government, voters cannot know what they are choosing.",
        "codes": [
          "elections",
          "freedoms",
          "politicians"
        ],
        "justified": true
      },
      {
        "idx": 7,
        "topic": "expect",
        "module": "expectation",
        "text": "Equal treatment for everyone, honest officials, and citizens who have a say in decisions.",
        "codes": [
          "participation",
          "equality",
          "corruption"
        ],
        "justified": false
      },
      {
        "idx": 9,
        "topic": "expect",
        "module": "expectation",
        "text": "Having a say, because then people can fix the other problems themselves.",
        "codes": [],
        "justified": true
      },
      {
        "idx": 11,
        "topic": "tradeoff",
        "module": "expectation",
        "text": "Fair elections. Development without accountability ends up in a few pockets.",
        "codes": [
          "elections",
          "checks",
          "economy"
        ],
        "justified": true
      },
      {
        "idx": 13,
        "topic": "reality",
        "module": "expectation",
        "text": "Elections work well and power changes hands peacefully. But corruption is still a problem, and citizens rarely have a say in decisions. Equal treatment is improving.",
        "codes": [
          "elections",
          "participation",
          "equality",
          "corruption",
          "order"
        ],
        "justified": false
      },
      {
        "idx": 15,
        "topic": "vote_scenario",
        "module": "behaviour",
        "text": "The honest one. Arresting journalists is a line I would not cross, even for new roads.",
        "codes": [
          "freedoms",
          "economy",
          "corruption"
        ],
        "justified": false
      },
      {
        "idx": 17,
        "topic": "party_scenario",
        "module": "behaviour",
        "text": "I would not vote for them again. Postponing elections is how democracies end, whichever party does it.",
        "codes": [
          "elections",
          "politicians"
        ],
        "justified": false
      },
      {
        "idx": 19,
        "topic": "past_behaviour",
        "module": "behaviour",
        "text": "Yes, I always vote. It is the least a citizen can do.",
        "codes": [
          "elections"
        ],
        "justified": false
      }
